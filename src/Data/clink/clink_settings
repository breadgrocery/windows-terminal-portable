# name: A suggested command may appear after the cursor
# type: boolean
autosuggest.inline=true

# name: Auto-update the Clink program files
# options: off,check,prompt,auto
clink.autoupdate = off

# name: Controls what startup logo to show
# options: none,full,short
clink.logo = none

# name: Controls whether to remove blank lines before the prompt
# options: normal,compact,sparse
prompt.spacing=compact

# name: The number of history lines to save
# type: number
history.max_lines=999
